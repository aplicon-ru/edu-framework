          "type": [
            "string",
            "null"
          ]
        },
        "specialtyCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "specialtyName": {
          "type": [
            "string",
            "null"
          ]
        },
        "profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "qualification": {
          "type": [
            "string",
            "null"
          ]
        },
        "academicYear": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "disciplineContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disciplineId": {
          "type": [
            "string",
            "null"
          ]
        },
        "disciplineCode": {
          "type": [
