            "string",
            "null"
          ]
        },
        "moduleName": {
          "type": [
            "string",
            "null"
          ]
        },
        "curriculumId": {
          "type": [
            "string",
            "null"
          ]
        },
        "opopId": {
          "type": [
            "string",
            "null"
          ]
        },
        "fgosId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
