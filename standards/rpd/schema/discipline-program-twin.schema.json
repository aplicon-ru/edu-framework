            "manualPerson",
            "reference",
            "disciplineReference",
            "practiceReference",
            "contractReference",
            "competencyResult",
            "indicator",
            "controlForm",
            "studyPeriod",
            "topic",
            "lesson",
            "lessonCard",
            "literatureItem",
            "electronicResource",
            "equipmentItem",
            "softwareItem",
            "text",
            null
