{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aplicon-ru/edu-framework/standards/rpd/schema/discipline-program-twin.schema.json",
  "title": "Двойник рабочей программы дисциплины",
  "description": "JSON Schema цифрового двойника РПД, модель v0.2.0. Валидирует единый объект, обслуживающий заполнение, проверку, печать, обратное восстановление и трассировку. Слои forms/print/reverseImport описывают представление и реализацию; норма — context/content/fieldRegistry/validation/relations.",
  "$comment": "АДРЕСАЦИЯ ПУТЕЙ. Поля path/source/binding используют точечную нотацию от корня объекта (например content.generalCharacteristics.workload.totalHours). Суффикс [] означает «каждый элемент массива по этому пути» — это шаблонный путь, а не указатель на конкретный элемент; для адресации конкретного значения экземпляра применяется JSON Pointer (RFC 6901) с числовыми индексами. Уникальный ключ записи реестра — fieldId; значение path может повторяться у записей, описывающих варианты одного массива (например типы форм контроля). ИСТОЧНИК ИСТИНЫ. Поля с source.sourceType=curriculum/opop/reference и fillMode=derived являются read-only проекциями внешних объектов (учебный план, ОПОП, справочники); их редактирование выполняется в источнике, а не в Двойнике. ВЕРСИОНИРОВАНИЕ. Двойник не несёт собственной оси версий: логическая версия РПД фиксируется участием редакции в Версии ОПОП (edu-framework D06). context.education.academicYear и context.documentLifecycle описывают документооборот и не подменяют норму-версию.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "twinMeta",
    "context",
    "sourceModel",
    "content",
    "fieldRegistry",
    "forms",
    "print",
    "reverseImport",
    "validation",
    "provenance",
    "relations",
    "audit"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "twinMeta": {
      "$ref": "#/$defs/twinMeta"
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "sourceModel": {
      "$ref": "#/$defs/sourceModel"
    },
    "content": {
      "$ref": "#/$defs/content"
    },
    "fieldRegistry": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fieldRegistryItem"
      }
    },
    "forms": {
      "$ref": "#/$defs/formsLayer"
    },
    "print": {
      "$ref": "#/$defs/printLayer"
    },
    "reverseImport": {
      "$ref": "#/$defs/reverseImportLayer"
    },
    "validation": {
      "$ref": "#/$defs/validationLayer"
    },
    "provenance": {
      "$ref": "#/$defs/provenanceLayer"
    },
    "relations": {
      "$ref": "#/$defs/relationsLayer"
    },
    "audit": {
      "$ref": "#/$defs/auditLayer"
    }
  },
  "$defs": {
    "educationDirection": {
      "type": "string",
      "enum": [
        "DO",
        "SPO",
        "BACHELOR",
        "SPECIALIST",
        "MASTER",
        "ORDINATURA",
        "ASPIRANTURA",
        "DPO"
      ]
    },
    "educationDirectionGroup": {
      "type": "string",
      "enum": [
        "DO",
        "SPO",
        "VO",
        "DPO"
      ]
    },
    "educationLevel": {
      "type": "string",
      "enum": [
        "DO",
        "SPO",
        "VO",
        "DPO"
      ]
    },
    "twinMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "twinId",
        "twinType",
        "twinModelVersion",
        "status"
      ],
      "properties": {
        "twinId": {
          "type": "string"
        },
        "twinType": {
          "const": "disciplineProgram"
        },
        "twinName": {
          "type": [
            "string",
            "null"
          ]
        },
        "twinModelVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "examples": [
            "0.2.0"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "template",
            "instance",
            "draft",
            "in_review",
            "approved",
            "published",
            "archived",
            "imported",
            "requires_update"
          ]
        },
        "createdAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "organizationContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organizationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "organizationName": {
          "type": [
            "string",
            "null"
          ]
        },
        "departmentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "departmentName": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "supportedDirection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/educationDirection"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "group": {
          "$ref": "#/$defs/educationDirectionGroup"
        }
      }
    },
    "educationContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "educationLevel": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "DO",
            "SPO",
            "VO",
            "DPO",
            null
          ]
        },
        "educationDirection": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "DO",
            "SPO",
            "BACHELOR",
            "SPECIALIST",
            "MASTER",
            "ORDINATURA",
            "ASPIRANTURA",
