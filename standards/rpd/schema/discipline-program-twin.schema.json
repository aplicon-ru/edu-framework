        },
        "lessonCards": {
          "$ref": "#/$defs/flexibleSection"
        },
        "implementationConditions": {
          "$ref": "#/$defs/flexibleSection"
        }
      }
    },
    "fieldSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceType"
      ],
      "properties": {
        "sourceType": {
          "type": "string",
          "enum": [
            "manual",
            "curriculum",
            "opop",
            "reference",
            "typicalProgram",
            "classroomFund",
            "contracts",
            "external",
            "system",
            "content",
            "manual_or_curriculum",
            "manual_or_program",
            "manual_or_reference",
            "template_or_manual"
          ]
        },
        "fillMode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "manual",
            "derived",
            "link",
            "mixed",
            "select_from_reference",
            "calculated_or_flag",
            "derived_or_manual",
            "derived_or_select",
            "manual_or_derived",
            "select_or_default",
            "select_or_derived",
            "select_or_manual",
            "template_or_manual",
            null
          ]
        },
        "sourcePath": {
          "type": [
            "string",
            "null"
          ],
          "format": "json-pointer",
          "description": "Адрес поля-источника в формате JSON Pointer (RFC 6901), напр. /curriculum/professionalModule/name. Не dot-notation."
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "fieldPresentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "formLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "printLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceWorksheet": {
          "type": [
            "string",
            "null"
          ]
        }
      }
