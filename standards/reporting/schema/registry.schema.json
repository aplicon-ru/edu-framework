{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framework.aplicon.ru/standards/reporting/schema/registry.schema.json",
  "title": "Реестр регламентной отчётности образовательных организаций",
  "type": "object",
  "required": ["title", "version", "as_of", "organization_types", "sections", "verification_legend", "reports"],
  "properties": {
    "title": {"type": "string"},
    "version": {"type": "string"},
    "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "organization_types": {"type": "object", "additionalProperties": {"type": "string"}},
    "sections": {"type": "object", "additionalProperties": {"type": "string"}},
    "verification_legend": {"type": "object", "additionalProperties": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}},
    "reports": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/report"}}
  },
  "$defs": {
    "form": {
      "type": "object",
      "required": ["name", "kind"],
      "properties": {
        "name": {"type": "string"},
        "code": {"type": ["string", "null"]},
        "act_ref": {"type": ["string", "null"]},
        "kind": {"enum": ["blank", "xml_template", "online_form", "free_form", "none"]},
        "template_url": {"type": ["string", "null"]},
        "paper_print_required": {"type": ["boolean", "null"]}
      }
    },
    "report": {
      "type": "object",
      "required": ["id", "section", "name", "applies_to", "recipient", "channel", "kind", "periodicity", "deadline", "legal_basis", "verification", "contains_financial_block", "notes", "submission", "system", "format", "signature", "form_code", "forms", "print_note", "format_check", "format_sources"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)+$"},
        "section": {"enum": ["STAT", "ADM", "DOC", "SELF", "GIA", "LIC", "REL", "MED"]},
        "name": {"type": "string"},
        "applies_to": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["VO", "SPO", "DO_PRE", "DO_ADD", "DPO"]}},
        "recipient": {"type": "string"},
        "channel": {"type": "string"},
        "kind": {"enum": ["periodic", "event", "continuous"]},
        "periodicity": {"type": "string"},
        "deadline": {"type": "string"},
        "legal_basis": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "verification": {"enum": ["verified_2026-10", "verified_secondary_2026-10", "to_verify"]},
        "contains_financial_block": {"type": "boolean"},
        "notes": {"type": "string"},
        "sources": {"type": "array", "items": {"type": "string"}},
        "submission": {"type": "array", "minItems": 1, "items": {"enum": ["fsn_web", "fis_web", "fis_api", "gosuslugi", "vendor_lk", "smev", "org_site", "paper", "email", "tks", "other"]}},
        "system": {"type": ["string", "null"]},
        "format": {"type": "string"},
        "signature": {"enum": ["ukep", "mchd", "ukep_mchd", "none", "unknown"]},
        "form_code": {"type": ["string", "null"]},
        "forms": {"type": "array", "items": {"$ref": "#/$defs/form"}},
        "print_note": {"type": "string"},
        "format_check": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["primary", "secondary", "inferred", "unresolved"]}, "note": {"type": "string"}}},
        "format_sources": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
